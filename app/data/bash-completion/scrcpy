_scrcpy() {
    local cur prev words cword
    local opts="
        --always-on-top
        --angle
        --audio-bit-rate=
        --audio-buffer=
        --audio-codec=
        --audio-codec-options=
        --audio-dup
        --audio-match-packages=
        --audio-encoder=
        --audio-source=
        --autofocus-window
        --audio-output-buffer=
        --audio-output-device=
        -b --video-bit-rate=
        --background-color=
        --camera-ar=
        --camera-id=
        --camera-facing=
        --camera-ae-lock
        --camera-awb-lock
        --camera-eis
        --camera-ev=
        --camera-exposure=
        --camera-iso=
        --camera-ois
        --camera-focus-distance=
        --camera-fps=
        --camera-high-speed
        --camera-size=
        --camera-torch
        --camera-zoom=
        --camera-pip
        --capture-orientation=
        --client-audio-source=
        --clipboard-image
        --config-file=
        --crop=
        -d --select-usb
        --disable-screensaver
        --disconnect-timeout=
        --display-id=
        --display-ime-policy=
        --display-orientation=
        -e --select-tcpip
        -f --fullscreen
        --force-adb-forward
        -G
        --gamepad=
        -h --help
        --hwdec=
        --ime
        --ignore-video-encoder-constraints
        -K
        --keep-active
        --keyboard=
        --keyboard-grab=
        --kill-adb-on-close
        --latency-stats
        --latency-probe
        --legacy-paste
        --list-apps
        --list-camera-sizes
        --list-cameras
        --list-client-audio-sources
        --list-displays
        --list-encoders
        -m --max-size=
        -M
        --max-fps=
        --min-size-alignment=
        --mouse=
        --mouse-bind=
        --mpris
        -n --no-control
        -N --no-playback
        --new-display
        --new-display=
        --no-audio
        --no-audio-playback
        --no-camera-autofocus
        --no-cleanup
        --no-clipboard-autosync
        --no-config
        --no-downsize-on-error
        --no-key-repeat
        --no-mipmaps
        --no-mouse-hover
        --no-power-on
        --no-server-push
        --no-terminal-title
        --no-vd-destroy-content
        --no-vd-system-decorations
        --no-video
        --no-video-playback
        --no-window
        --no-window-aspect-ratio-lock
        --no-window-auto-resize
        --orientation=
        --otg
        --otg-automatic-screenshot
        -p --port=
        --pause-on-exit
        --pause-on-exit=
        --power-off-on-close
        --prefer-text
        --print-fps
        --push-target=
        --reconnect
        -r --record=
        --raw-key-events
        --record-format=
        --record-pts=
        --record-segment=
        --record-orientation=
        --render-driver=
        --render-fit=
        --require-audio
        -s --serial=
        -S --turn-screen-off
        --screen-off-timeout=
        --shortcut-key=
        --shortcut-mod=
        --start-app=
        --stream-sink=
        --show-axis
        --show-keymap
        -t --show-touches
        --tcpip
        --tcpip=
        --text-via-clipboard
        --time-limit=
        --touchscreen-id=
        --trackpad
        --wheel-pinch
        --keymap=
        --tunnel-host=
        --tunnel-port=
        --v4l2-buffer=
        --v4l2-sink=
        -v --version
        -V --verbosity=
        --video-buffer=
        --video-codec=
        --video-codec-options=
        --video-decoder=
        --video-encoder=
        --video-source=
        --vsync
        -w --stay-awake
        --window-borderless
        --window-parent=
        --window-title=
        --window-x=
        --window-y=
        --window-width=
        --window-height=
        --window-size-unit=
        -x --flex-display"

    _init_completion -s || return

    case "$prev" in
        --video-codec)
            COMPREPLY=($(compgen -W 'h264 h265 av1 vp8 vp9 apv mjpeg' -- "$cur"))
            return
            ;;
        --audio-codec)
            COMPREPLY=($(compgen -W 'opus aac flac raw' -- "$cur"))
            return
            ;;
        --video-source)
            COMPREPLY=($(compgen -W 'display camera' -- "$cur"))
            return
            ;;
        --audio-source)
            COMPREPLY=($(compgen -W 'output playback mic mic-unprocessed mic-camcorder mic-voice-recognition mic-voice-communication voice-call voice-call-uplink voice-call-downlink voice-performance' -- "$cur"))
            return
            ;;
        --camera-facing)
            COMPREPLY=($(compgen -W 'front back external' -- "$cur"))
            return
            ;;
        --keyboard)
            COMPREPLY=($(compgen -W 'disabled sdk uhid aoa' -- "$cur"))
            return
            ;;
        --keyboard-grab)
            COMPREPLY=($(compgen -W 'disabled fullscreen' -- "$cur"))
            return
            ;;
        --mouse)
            COMPREPLY=($(compgen -W 'disabled sdk uhid aoa' -- "$cur"))
            return
            ;;
        --gamepad)
            COMPREPLY=($(compgen -W 'disabled uhid aoa' -- "$cur"))
            return
            ;;
        --capture-orientation)
            COMPREPLY=($(compgen -W '0 90 180 270 flip0 flip90 flip180 flip270 @0 @90 @180 @270 @flip0 @flip90 @flip180 @flip270' -- "$cur"))
            return
            ;;
        --orientation|--display-orientation)
            COMPREPLY=($(compgen -W '0 90 180 270 flip0 flip90 flip180 flip270' -- "$cur"))
            return
            ;;
        --display-ime-policy)
            COMPREPLY=($(compgen -W 'local fallback hide' -- "$cur"))
            return
            ;;
        --record-orientation)
            COMPREPLY=($(compgen -W '0 90 180 270' -- "$cur"))
            return
            ;;
        --pause-on-exit)
            COMPREPLY=($(compgen -W 'true false if-error' -- "$cur"))
            return
            ;;
        --config-file|--keymap|-r|--record|--record-pts)
            COMPREPLY=($(compgen -f -- "$cur"))
            return
            ;;
        --record-format)
            COMPREPLY=($(compgen -W 'mp4 mkv m4a mka opus aac flac wav' -- "$cur"))
            return
            ;;
        --render-driver)
            COMPREPLY=($(compgen -W 'direct3d opengl opengles2 opengles metal software' -- "$cur"))
            return
            ;;
        --render-fit)
            COMPREPLY=($(compgen -W 'letterbox stretched unscaled' -- "$cur"))
            return
            ;;
        --shortcut-mod)
            # Only auto-complete a single key
            COMPREPLY=($(compgen -W 'lctrl rctrl lalt ralt lsuper rsuper' -- "$cur"))
            return
            ;;
        -V|--verbosity)
            COMPREPLY=($(compgen -W 'verbose debug info warn error' -- "$cur"))
            return
            ;;
        -s|--serial)
            # Use 'adb devices' to list serial numbers
            COMPREPLY=($(compgen -W "$("${ADB:-adb}" devices | awk '$2 == "device" {print $1}')" -- ${cur}))
            return
            ;;
        --min-size-alignment)
            COMPREPLY=($(compgen -W '1 2 4 8 16' -- "$cur"))
            return
            ;;
        --hwdec)
            COMPREPLY=($(compgen -W 'auto disabled vaapi d3d11va videotoolbox' -- "$cur"))
            return
            ;;
        --window-size-unit)
            COMPREPLY=($(compgen -W 'logical physical' -- "$cur"))
            return
            ;;
        --audio-bit-rate \
        |--audio-buffer \
        |-b|--video-bit-rate \
        |--audio-codec-options \
        |--audio-encoder \
        |--audio-output-buffer \
        |--audio-output-device \
        |--background-color \
        |--camera-ar \
        |--camera-id \
        |--camera-ev \
        |--camera-exposure \
        |--camera-iso \
        |--camera-focus-distance \
        |--camera-fps \
        |--camera-size \
        |--camera-torch \
        |--camera-zoom \
        |--crop \
        |--display-id \
        |--max-fps \
        |-m|--max-size \
        |--new-display \
        |-p|--port \
        |--push-target \
        |--rotation \
        |--screen-off-timeout \
        |--tunnel-host \
        |--tunnel-port \
        |--v4l2-buffer \
        |--v4l2-sink \
        |--video-buffer \
        |--video-codec-options \
        |--video-decoder \
        |--video-encoder \
        |--tcpip \
        |--window-*)
            # Option accepting an argument, but nothing to auto-complete
            return
            ;;
    esac

    COMPREPLY=($(compgen -W "$opts" -- "$cur"))
    [[ $COMPREPLY == *= ]] && compopt -o nospace
}

complete -F _scrcpy scrcpy
